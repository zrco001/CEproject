{
  "name": "@ceproject/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-free domain primitives: money, business dates, enums, state machines, metric status whitelists.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "default": "./dist/money/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "default": "./dist/date/index.js"
    },
    "./enums": {
      "types": "./dist/enums/index.d.ts",
      "default": "./dist/enums/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@ceproject/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
