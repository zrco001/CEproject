  billingDate           DateTime              @db.Date
  invoiceDate           DateTime?             @db.Date
  invoiceNumber         String?
  dueDate               DateTime?             @db.Date
  expectedPaymentDate   DateTime?             @db.Date
  approvedAmount        Decimal?              @db.Decimal(18, 2)
  submittedAt           DateTime?             @db.Timestamptz(3)
  approvedAt            DateTime?             @db.Timestamptz(3)
  invoicedAt            DateTime?             @db.Timestamptz(3)
