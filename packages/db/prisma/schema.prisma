/// sourceType must match the source foreign keys (receivable_source_check).
model Receivable {
  id                 String            @id(map: "receivable_pkey") @default(uuid(7)) @db.Uuid
  organizationId     String            @db.Uuid
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receivable_organization_id_fkey")
  customerId         String            @db.Uuid
  customer           Customer          @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receivable_customer_id_org_fkey")
  projectId          String?           @db.Uuid
  project            Project?          @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receivable_project_id_org_fkey")
  sourceType         ReceivableSource
  /// 1 : 0..1 (unique); Prisma models it as 1:N, see Payable.expenseId.
  progressBillingId  String?           @unique(map: "receivable_progress_billing_id_key") @db.Uuid
  progressBilling    ProgressBilling?  @relation(fields: [organizationId, progressBillingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receivable_progress_billing_id_org_fkey")
  /// 1 : 0..1 (unique); Prisma models it as 1:N, see Payable.expenseId.
  retentionReleaseId String?           @unique(map: "receivable_retention_release_id_key") @db.Uuid
  retentionRelease   RetentionRelease? @relation(fields: [organizationId, retentionReleaseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receivable_retention_release_id_org_fkey")
  receivableNo       String
  originalAmount     Decimal           @db.Decimal(18, 2)
  /// Cache (ADR-09).
  paidAmount         Decimal           @default(0) @db.Decimal(18, 2)
  /// Cache (ADR-09).
  outstandingAmount  Decimal           @db.Decimal(18, 2)
  dueDate            DateTime?         @db.Date
  status             ReceivableStatus  @default(UNPAID)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  createdById        String            @db.Uuid
  createdBy          User              @relation("Receivable_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receivable_created_by_id_fkey")
  updatedById        String?           @db.Uuid
  updatedBy          User?             @relation("Receivable_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receivable_updated_by_id_fkey")

  receiptAllocations ReceiptAllocation[]

  @@unique([organizationId, id], map: "receivable_org_id_key")
}

/// MVP application rule: feeBearer stays COMPANY (§3.5); the CHECK still covers both branches.
model Receipt {
  id                String           @id(map: "receipt_pkey") @default(uuid(7)) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_organization_id_fkey")
  customerId        String           @db.Uuid
  customer          Customer         @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_customer_id_org_fkey")
  /// Optional project tag for deposits / advance receipts (§3.5).
  projectId         String?          @db.Uuid
  project           Project?         @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_project_id_org_fkey")
  bankAccountId     String           @db.Uuid
  bankAccount       BankAccount      @relation(fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_bank_account_id_org_fkey")
  receiptNo         String
  receiptDate       DateTime         @db.Date
  method            PaymentMethod
  receivedAmount    Decimal          @db.Decimal(18, 2)
  /// Cache (ADR-09): Σ active ReceiptAllocation.amount.
  allocatedAmount   Decimal          @default(0) @db.Decimal(18, 2)
  /// Cache (ADR-09).
  unallocatedAmount Decimal          @db.Decimal(18, 2)
  feeAmount         Decimal          @default(0) @db.Decimal(18, 2)
  feeBearer         FeeBearer        @default(COMPANY)
  /// Cache (ADR-09), defined by feeBearer (I-12).
  bankInflowAmount  Decimal          @db.Decimal(18, 2)
  clearingStatus    ClearingStatus   @default(NOT_APPLICABLE)
  clearedAt         DateTime?        @db.Timestamptz(3)
  clearedById       String?          @db.Uuid
  clearedBy         User?            @relation("Receipt_clearedBy", fields: [clearedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_cleared_by_id_fkey")
  clearedDate       DateTime?        @db.Date
  bouncedAt         DateTime?        @db.Timestamptz(3)
  bouncedById       String?          @db.Uuid
  bouncedBy         User?            @relation("Receipt_bouncedBy", fields: [bouncedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_bounced_by_id_fkey")
  bounceReason      String?
  checkNo           String?
  checkBank         String?
  checkDueDate      DateTime?        @db.Date
  note              String?
  clientRequestId   String?          @db.Uuid
  status            SettlementStatus @default(POSTED)
  voidedAt          DateTime?        @db.Timestamptz(3)
  voidedById        String?          @db.Uuid
  voidedBy          User?            @relation("Receipt_voidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_voided_by_id_fkey")
  voidReason        String?
  version           Int              @default(1)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  createdById       String           @db.Uuid
  createdBy         User             @relation("Receipt_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_created_by_id_fkey")
  updatedById       String?          @db.Uuid
  updatedBy         User?            @relation("Receipt_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_updated_by_id_fkey")

  receiptAllocations ReceiptAllocation[]

  @@unique([organizationId, id], map: "receipt_org_id_key")
}

/// Active allocation ⇔ voidedAt IS NULL (ADR-25); one active row per pair (I-02).
model ReceiptAllocation {
  id             String       @id(map: "receipt_allocation_pkey") @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_allocation_organization_id_fkey")
  receiptId      String       @db.Uuid
  receipt        Receipt      @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_allocation_receipt_id_org_fkey")
  receivableId   String       @db.Uuid
  receivable     Receivable   @relation(fields: [organizationId, receivableId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_allocation_receivable_id_org_fkey")
  amount         Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  createdById    String       @db.Uuid
  createdBy      User         @relation("ReceiptAllocation_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_allocation_created_by_id_fkey")
  voidedAt       DateTime?    @db.Timestamptz(3)
  voidedById     String?      @db.Uuid
  voidedBy       User?        @relation("ReceiptAllocation_voidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "receipt_allocation_voided_by_id_fkey")
  voidReason     String?

  @@unique([organizationId, id], map: "receipt_allocation_org_id_key")
}

/// ProgressBilling 1 : N RevenueEntry (ADR-29): progressBillingId is NOT unique; idempotency is
/// the sourceKey partial unique index (I-18).
model RevenueEntry {
  id                String           @id(map: "revenue_entry_pkey") @default(uuid(7)) @db.Uuid
  organizationId    String           @db.Uuid
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "revenue_entry_organization_id_fkey")
  projectId         String?          @db.Uuid
  project           Project?         @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "revenue_entry_project_id_org_fkey")
  progressBillingId String?          @db.Uuid
  progressBilling   ProgressBilling? @relation(fields: [organizationId, progressBillingId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "revenue_entry_progress_billing_id_org_fkey")
  sourceKey         String?
  sourceType        RevenueSource
  recognitionDate   DateTime         @db.Date
  /// Excluding tax (D-01).
  amount            Decimal          @db.Decimal(18, 2)
  taxAmount         Decimal          @db.Decimal(18, 2)
  description       String?
  clientRequestId   String?          @db.Uuid
  status            RevenueStatus    @default(POSTED)
  voidedAt          DateTime?        @db.Timestamptz(3)
  voidedById        String?          @db.Uuid
  voidedBy          User?            @relation("RevenueEntry_voidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "revenue_entry_voided_by_id_fkey")
  voidReason        String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  createdById       String           @db.Uuid
  createdBy         User             @relation("RevenueEntry_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "revenue_entry_created_by_id_fkey")
  updatedById       String?          @db.Uuid
  updatedBy         User?            @relation("RevenueEntry_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "revenue_entry_updated_by_id_fkey")

  @@unique([organizationId, id], map: "revenue_entry_org_id_key")
}

// ---------------------------------------------------------------------------------------------
// Treasury (§6.2)
// ---------------------------------------------------------------------------------------------

/// sourceId is polymorphic (Payment / Receipt / …) and has no foreign key; the Treasury
/// invariants of §3.5 are application rules checked by reconciliation.
model BankTransaction {
  id             String        @id(map: "bank_transaction_pkey") @default(uuid(7)) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_transaction_organization_id_fkey")
  bankAccountId  String        @db.Uuid
  bankAccount    BankAccount   @relation(fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "bank_transaction_bank_account_id_org_fkey")
  txnDate        DateTime      @db.Date
  direction      TxnDirection
  amount         Decimal       @db.Decimal(18, 2)
  sourceType     BankTxnSource
  sourceId       String?       @db.Uuid
  counterparty   String?
  description    String?
  externalRef    String?
  status         BankTxnStatus @default(POSTED)
  voidedAt       DateTime?     @db.Timestamptz(3)
  voidedById     String?       @db.Uuid
  voidedBy       User?         @relation("BankTransaction_voidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_transaction_voided_by_id_fkey")
  voidReason     String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  createdById    String        @db.Uuid
  createdBy      User          @relation("BankTransaction_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_transaction_created_by_id_fkey")
  updatedById    String?       @db.Uuid
  updatedBy      User?         @relation("BankTransaction_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_transaction_updated_by_id_fkey")

  @@unique([organizationId, id], map: "bank_transaction_org_id_key")
  @@index([bankAccountId, txnDate], map: "bank_transaction_account_date_idx")
  @@index([organizationId, sourceType, sourceId], map: "bank_transaction_source_idx")
}
