// ---------------------------------------------------------------------------------------------
// Platform (§6.2)
// ---------------------------------------------------------------------------------------------

model Organization {
  id                  String    @id(map: "organization_pkey") @default(uuid(7)) @db.Uuid
  name                String
  taxId               String?
  timezone            String    @default("Asia/Taipei")
  currency            String    @default("TWD")
  defaultTaxRate      Decimal   @default(0.0500) @db.Decimal(7, 4)
  allowDecimalAmounts Boolean   @default(false)
  lockedUntilDate     DateTime? @db.Date
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  memberships                 Membership[]
  roles                       Role[]
  auditLogs                   AuditLog[]
  documentSequences           DocumentSequence[]
  attachments                 Attachment[]
  attachmentLinks             AttachmentLink[]
  customers                   Customer[]
  vendors                     Vendor[]
  employees                   Employee[]
  costCategories              CostCategory[]
  bankAccounts                BankAccount[]
  projects                    Project[]
  projectMembers              ProjectMember[]
  contracts                   Contract[]
  changeOrders                ChangeOrder[]
  projectBudgets              ProjectBudget[]
  projectDailyLogs            ProjectDailyLog[]
  expenses                    Expense[]
  expenseItems                ExpenseItem[]
  payables                    Payable[]
  payments                    Payment[]
  payablePayments             PayablePayment[]
  pettyCashTransactions       PettyCashTransaction[]
  progressBillings            ProgressBilling[]
  progressBillingChangeOrders ProgressBillingChangeOrder[]
  retentionReleases           RetentionRelease[]
  receivables                 Receivable[]
  receipts                    Receipt[]
  receiptAllocations          ReceiptAllocation[]
  revenueEntries              RevenueEntry[]
  bankTransactions            BankTransaction[]
}

/// Login account. No organizationId: users join organizations through Membership.
/// email is stored lowercase (normalized by the application, Phase 3).
model User {
  id           String    @id(map: "user_pkey") @default(uuid(7)) @db.Uuid
  email        String    @unique(map: "user_email_key")
  passwordHash String
  name         String
  phone        String?
  timezone     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  memberships                        Membership[]                 @relation("Membership_user")
  membershipsCreated                 Membership[]                 @relation("Membership_createdBy")
  membershipsUpdated                 Membership[]                 @relation("Membership_updatedBy")
  refreshTokens                      RefreshToken[]               @relation("RefreshToken_user")
  auditLogs                          AuditLog[]                   @relation("AuditLog_user")
  attachmentsUploaded                Attachment[]                 @relation("Attachment_uploadedBy")
  attachmentsCreated                 Attachment[]                 @relation("Attachment_createdBy")
  attachmentsUpdated                 Attachment[]                 @relation("Attachment_updatedBy")
  customersCreated                   Customer[]                   @relation("Customer_createdBy")
  customersUpdated                   Customer[]                   @relation("Customer_updatedBy")
  vendorsCreated                     Vendor[]                     @relation("Vendor_createdBy")
  vendorsUpdated                     Vendor[]                     @relation("Vendor_updatedBy")
  employees                          Employee[]                   @relation("Employee_user")
  employeesCreated                   Employee[]                   @relation("Employee_createdBy")
  costCategoriesCreated              CostCategory[]               @relation("CostCategory_createdBy")
  costCategoriesUpdated              CostCategory[]               @relation("CostCategory_updatedBy")
  bankAccountsCreated                BankAccount[]                @relation("BankAccount_createdBy")
  bankAccountsUpdated                BankAccount[]                @relation("BankAccount_updatedBy")
  managedProjects                    Project[]                    @relation("Project_projectManager")
  projectsCreated                    Project[]                    @relation("Project_createdBy")
  projectsUpdated                    Project[]                    @relation("Project_updatedBy")
  projectMemberships                 ProjectMember[]              @relation("ProjectMember_user")
  contractsCreated                   Contract[]                   @relation("Contract_createdBy")
  contractsUpdated                   Contract[]                   @relation("Contract_updatedBy")
  changeOrdersApproved               ChangeOrder[]                @relation("ChangeOrder_approvedBy")
  changeOrdersCreated                ChangeOrder[]                @relation("ChangeOrder_createdBy")
  changeOrdersUpdated                ChangeOrder[]                @relation("ChangeOrder_updatedBy")
  projectBudgetsCreated              ProjectBudget[]              @relation("ProjectBudget_createdBy")
  projectBudgetsUpdated              ProjectBudget[]              @relation("ProjectBudget_updatedBy")
  projectDailyLogsCreated            ProjectDailyLog[]            @relation("ProjectDailyLog_createdBy")
  projectDailyLogsUpdated            ProjectDailyLog[]            @relation("ProjectDailyLog_updatedBy")
  expensesSubmitted                  Expense[]                    @relation("Expense_submittedBy")
  expensesReviewed                   Expense[]                    @relation("Expense_reviewedBy")
  expensesPosted                     Expense[]                    @relation("Expense_postedBy")
  expensesVoided                     Expense[]                    @relation("Expense_voidedBy")
  expensesCreated                    Expense[]                    @relation("Expense_createdBy")
  expensesUpdated                    Expense[]                    @relation("Expense_updatedBy")
  payablesCreated                    Payable[]                    @relation("Payable_createdBy")
  payablesUpdated                    Payable[]                    @relation("Payable_updatedBy")
  paymentsCleared                    Payment[]                    @relation("Payment_clearedBy")
  paymentsBounced                    Payment[]                    @relation("Payment_bouncedBy")
  paymentsVoided                     Payment[]                    @relation("Payment_voidedBy")
  paymentsCreated                    Payment[]                    @relation("Payment_createdBy")
  paymentsUpdated                    Payment[]                    @relation("Payment_updatedBy")
  payablePaymentsCreated             PayablePayment[]             @relation("PayablePayment_createdBy")
  payablePaymentsVoided              PayablePayment[]             @relation("PayablePayment_voidedBy")
  pettyCashTransactionsAsCustodian   PettyCashTransaction[]       @relation("PettyCashTransaction_custodian")
  pettyCashTransactionsVoided        PettyCashTransaction[]       @relation("PettyCashTransaction_voidedBy")
  pettyCashTransactionsCreated       PettyCashTransaction[]       @relation("PettyCashTransaction_createdBy")
  pettyCashTransactionsUpdated       PettyCashTransaction[]       @relation("PettyCashTransaction_updatedBy")
  progressBillingsVoided             ProgressBilling[]            @relation("ProgressBilling_voidedBy")
  progressBillingsCreated            ProgressBilling[]            @relation("ProgressBilling_createdBy")
  progressBillingsUpdated            ProgressBilling[]            @relation("ProgressBilling_updatedBy")
  progressBillingChangeOrdersCreated ProgressBillingChangeOrder[] @relation("ProgressBillingChangeOrder_createdBy")
  retentionReleasesVoided            RetentionRelease[]           @relation("RetentionRelease_voidedBy")
  retentionReleasesCreated           RetentionRelease[]           @relation("RetentionRelease_createdBy")
  retentionReleasesUpdated           RetentionRelease[]           @relation("RetentionRelease_updatedBy")
  receivablesCreated                 Receivable[]                 @relation("Receivable_createdBy")
  receivablesUpdated                 Receivable[]                 @relation("Receivable_updatedBy")
  receiptsCleared                    Receipt[]                    @relation("Receipt_clearedBy")
  receiptsBounced                    Receipt[]                    @relation("Receipt_bouncedBy")
  receiptsVoided                     Receipt[]                    @relation("Receipt_voidedBy")
  receiptsCreated                    Receipt[]                    @relation("Receipt_createdBy")
  receiptsUpdated                    Receipt[]                    @relation("Receipt_updatedBy")
  receiptAllocationsCreated          ReceiptAllocation[]          @relation("ReceiptAllocation_createdBy")
  receiptAllocationsVoided           ReceiptAllocation[]          @relation("ReceiptAllocation_voidedBy")
  revenueEntriesVoided               RevenueEntry[]               @relation("RevenueEntry_voidedBy")
  revenueEntriesCreated              RevenueEntry[]               @relation("RevenueEntry_createdBy")
  revenueEntriesUpdated              RevenueEntry[]               @relation("RevenueEntry_updatedBy")
  bankTransactionsVoided             BankTransaction[]            @relation("BankTransaction_voidedBy")
  bankTransactionsCreated            BankTransaction[]            @relation("BankTransaction_createdBy")
  bankTransactionsUpdated            BankTransaction[]            @relation("BankTransaction_updatedBy")
}

model Membership {
  id             String           @id(map: "membership_pkey") @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "membership_organization_id_fkey")
  userId         String           @db.Uuid
  user           User             @relation("Membership_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "membership_user_id_fkey")
  roleId         String           @db.Uuid
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "membership_role_id_fkey")
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  createdById    String           @db.Uuid
  createdBy      User             @relation("Membership_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "membership_created_by_id_fkey")
  updatedById    String?          @db.Uuid
  updatedBy      User?            @relation("Membership_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "membership_updated_by_id_fkey")

  @@unique([organizationId, userId], map: "membership_organization_id_user_id_key")
}

/// System roles have organizationId NULL. Code uniqueness is enforced by the partial unique
/// indexes role_system_code_uq / role_org_code_uq (I-03 / I-04), not by a Prisma @@unique.
model Role {
  id             String        @id(map: "role_pkey") @default(uuid(7)) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "role_organization_id_fkey")
  code           String
  name           String
  isSystem       Boolean       @default(false)

  memberships     Membership[]
  rolePermissions RolePermission[]
}

/// Maintained by the seed program (§6.2).
model Permission {
  id          String @id(map: "permission_pkey") @default(uuid(7)) @db.Uuid
  code        String @unique(map: "permission_code_key")
  module      String
  description String

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "role_permission_role_id_fkey")
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "role_permission_permission_id_fkey")

  @@id([roleId, permissionId], map: "role_permission_pkey")
}

model RefreshToken {
  id           String         @id(map: "refresh_token_pkey") @default(uuid(7)) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation("RefreshToken_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refresh_token_user_id_fkey")
  tokenHash    String
  familyId     String         @db.Uuid
  expiresAt    DateTime       @db.Timestamptz(3)
  revokedAt    DateTime?      @db.Timestamptz(3)
  replacedById String?        @db.Uuid
  replacedBy   RefreshToken?  @relation("RefreshToken_replacedBy", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "refresh_token_replaced_by_id_fkey")
  replaces     RefreshToken[] @relation("RefreshToken_replacedBy")
}

/// Append-only (I-20: UPDATE / DELETE revoked from app_user). diff uses format v1 (§3.9, ADR-30).
model AuditLog {
  id             String       @id(map: "audit_log_pkey") @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_log_organization_id_fkey")
  userId         String?      @db.Uuid
  user           User?        @relation("AuditLog_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_log_user_id_fkey")
  action         AuditAction
  entityType     String
  entityId       String       @db.Uuid
  diff           Json
  schemaVersion  Int          @default(1)
  metadata       Json?
  requestId      String
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
}

model DocumentSequence {
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "document_sequence_organization_id_fkey")
  docType        String
  year           Int
  lastNumber     Int          @default(0)

  @@id([organizationId, docType, year], map: "document_sequence_pkey")
}

model Attachment {
  id             String           @id(map: "attachment_pkey") @default(uuid(7)) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "attachment_organization_id_fkey")
  fileName       String
  mimeType       String
  size           Int
  storageKey     String           @unique(map: "attachment_storage_key_key")
  url            String?
  checksum       String
  status         AttachmentStatus @default(PENDING)
  uploadedById   String           @db.Uuid
  uploadedBy     User             @relation("Attachment_uploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "attachment_uploaded_by_id_fkey")
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  createdById    String           @db.Uuid
  createdBy      User             @relation("Attachment_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "attachment_created_by_id_fkey")
  updatedById    String?          @db.Uuid
  updatedBy      User?            @relation("Attachment_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "attachment_updated_by_id_fkey")

  attachmentLinks AttachmentLink[]
}

/// Polymorphic link (TD-05): entityId has no foreign key; the service validates it.
model AttachmentLink {
  id             String            @id(map: "attachment_link_pkey") @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "attachment_link_organization_id_fkey")
  attachmentId   String            @db.Uuid
  attachment     Attachment        @relation(fields: [attachmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "attachment_link_attachment_id_fkey")
  entityType     AttachableType
  entityId       String            @db.Uuid
  purpose        AttachmentPurpose

  @@index([organizationId, entityType, entityId], map: "attachment_link_entity_idx")
}

// ---------------------------------------------------------------------------------------------
// Master data (§6.2). Composite targets for §6.5 rule 2 end in _org_id_key.
// ---------------------------------------------------------------------------------------------

model Customer {
  id             String       @id(map: "customer_pkey") @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customer_organization_id_fkey")
  name           String
  taxId          String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  note           String?
  archivedAt     DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  createdById    String       @db.Uuid
  createdBy      User         @relation("Customer_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customer_created_by_id_fkey")
  updatedById    String?      @db.Uuid
  updatedBy      User?        @relation("Customer_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customer_updated_by_id_fkey")

  projects    Project[]
  receivables Receivable[]
  receipts    Receipt[]

  @@unique([organizationId, id], map: "customer_org_id_key")
}

/// No plaintext bank account number column (§2.8, I-17).
model Vendor {
  id                      String       @id(map: "vendor_pkey") @default(uuid(7)) @db.Uuid
  organizationId          String       @db.Uuid
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vendor_organization_id_fkey")
  vendorType              VendorType
  name                    String
  taxId                   String?
  contactName             String?
  phone                   String?
  email                   String?
  address                 String?
  paymentTerms            String?
  paymentTermDays         Int?
  bankCode                String?
  bankBranch              String?
  bankAccountName         String?
  bankAccountNoCiphertext String?
  bankAccountNoKeyVersion Int?
  bankAccountNoLast4      String?
  bankAccountNoHmac       String?
  note                    String?
  archivedAt              DateTime?    @db.Timestamptz(3)
  createdAt               DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @db.Timestamptz(3)
  createdById             String       @db.Uuid
  createdBy               User         @relation("Vendor_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vendor_created_by_id_fkey")
  updatedById             String?      @db.Uuid
  updatedBy               User?        @relation("Vendor_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "vendor_updated_by_id_fkey")

  expenses Expense[]
  payables Payable[]
  payments Payment[]

  @@unique([organizationId, id], map: "vendor_org_id_key")
}

/// Person master (v0.3, ADR-26); not a login account. employeeNo / userId uniqueness per
/// organization is enforced by partial unique indexes (I-24).
model Employee {
  id                      String       @id(map: "employee_pkey") @default(uuid(7)) @db.Uuid
  organizationId          String       @db.Uuid
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employee_organization_id_fkey")
  userId                  String?      @db.Uuid
  user                    User?        @relation("Employee_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employee_user_id_fkey")
  employeeNo              String?
  name                    String
  phone                   String?
  email                   String?
  bankCode                String?
  bankAccountName         String?
  bankAccountNoCiphertext String?
  bankAccountNoKeyVersion Int?
  bankAccountNoLast4      String?
  isActive                Boolean      @default(true)
  createdAt               DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @db.Timestamptz(3)
  createdById             String       @db.Uuid
  createdBy               User         @relation("Employee_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "employee_created_by_id_fkey")

  advancedExpenses Expense[]
  payables         Payable[]
  payments         Payment[]

  @@unique([organizationId, id], map: "employee_org_id_key")
}

model CostCategory {
  id              String            @id(map: "cost_category_pkey") @default(uuid(7)) @db.Uuid
  organizationId  String            @db.Uuid
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cost_category_organization_id_fkey")
  parentId        String?           @db.Uuid
  parent          CostCategory?     @relation("CostCategory_parent", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cost_category_parent_id_fkey")
  children        CostCategory[]    @relation("CostCategory_parent")
  code            String
  name            String
  applicableScope CostCategoryScope
  sortOrder       Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdById     String            @db.Uuid
  createdBy       User              @relation("CostCategory_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cost_category_created_by_id_fkey")
  updatedById     String?           @db.Uuid
  updatedBy       User?             @relation("CostCategory_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cost_category_updated_by_id_fkey")

  projectBudgets ProjectBudget[]
  expenses       Expense[]
  expenseItems   ExpenseItem[]

  @@unique([organizationId, code], map: "cost_category_organization_id_code_key")
  @@unique([organizationId, id], map: "cost_category_org_id_key")
}

model BankAccount {
  id                  String          @id(map: "bank_account_pkey") @default(uuid(7)) @db.Uuid
  organizationId      String          @db.Uuid
  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_account_organization_id_fkey")
  type                BankAccountType
  name                String
  bankName            String?
  branch              String?
  accountNoCiphertext String?
  accountNoKeyVersion Int?
  accountNoLast4      String?
  currency            String          @default("TWD")
  openingBalance      Decimal         @db.Decimal(18, 2)
  openingDate         DateTime        @db.Date
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  createdById         String          @db.Uuid
  createdBy           User            @relation("BankAccount_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_account_created_by_id_fkey")
  updatedById         String?         @db.Uuid
  updatedBy           User?           @relation("BankAccount_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_account_updated_by_id_fkey")

  payments              Payment[]
  pettyCashTransactions PettyCashTransaction[]
  receipts              Receipt[]
  bankTransactions      BankTransaction[]

  @@unique([organizationId, id], map: "bank_account_org_id_key")
}

// ---------------------------------------------------------------------------------------------
// Project (§6.2)
// ---------------------------------------------------------------------------------------------

model Project {
  id                           String        @id(map: "project_pkey") @default(uuid(7)) @db.Uuid
  organizationId               String        @db.Uuid
  organization                 Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_organization_id_fkey")
  projectCode                  String
  name                         String
  customerId                   String        @db.Uuid
  customer                     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_customer_id_fkey")
  address                      String?
  projectManagerId             String?       @db.Uuid
  projectManager               User?         @relation("Project_projectManager", fields: [projectManagerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_project_manager_id_fkey")
  startDate                    DateTime?     @db.Date
  expectedEndDate              DateTime?     @db.Date
  actualEndDate                DateTime?     @db.Date
  /// Cache (ADR-09): recalculated from Contract / ChangeOrder.
  originalContractAmount       Decimal       @default(0) @db.Decimal(18, 2)
  /// Cache (ADR-09): recalculated when a ChangeOrder is APPROVED / CANCELLED.
  currentContractAmount        Decimal       @default(0) @db.Decimal(18, 2)
  retentionRate                Decimal       @db.Decimal(7, 4)
  retentionExpectedReleaseDate DateTime?     @db.Date
  physicalProgressPercent      Decimal?      @db.Decimal(5, 2)
  physicalProgressUpdatedAt    DateTime?     @db.Timestamptz(3)
  status                       ProjectStatus @default(DRAFT)
  note                         String?
  version                      Int           @default(1)
  createdAt                    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime      @updatedAt @db.Timestamptz(3)
  createdById                  String        @db.Uuid
  createdBy                    User          @relation("Project_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_created_by_id_fkey")
  updatedById                  String?       @db.Uuid
  updatedBy                    User?         @relation("Project_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_updated_by_id_fkey")

  projectMembers    ProjectMember[]
  contracts         Contract[]
  changeOrders      ChangeOrder[]
  projectBudgets    ProjectBudget[]
  projectDailyLogs  ProjectDailyLog[]
  expenses          Expense[]
  payables          Payable[]
  payments          Payment[]
  progressBillings  ProgressBilling[]
  retentionReleases RetentionRelease[]
  receivables       Receivable[]
  receipts          Receipt[]
  revenueEntries    RevenueEntry[]

  @@unique([organizationId, projectCode], map: "project_organization_id_project_code_key")
  @@unique([organizationId, id], map: "project_org_id_key")
}

model ProjectMember {
  projectId      String            @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_member_project_id_fkey")
  userId         String            @db.Uuid
  user           User              @relation("ProjectMember_user", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_member_user_id_fkey")
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_member_organization_id_fkey")
  projectRole    ProjectMemberRole

  @@id([projectId, userId], map: "project_member_pkey")
}

/// MVP: one active OWNER_CONTRACT per project (I-16 partial unique index).
model Contract {
  id             String         @id(map: "contract_pkey") @default(uuid(7)) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contract_organization_id_fkey")
  projectId      String         @db.Uuid
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contract_project_id_fkey")
  contractNo     String
  type           ContractType
  title          String
  signedDate     DateTime?      @db.Date
  amount         Decimal        @db.Decimal(18, 2)
  taxAmount      Decimal        @db.Decimal(18, 2)
  retentionRate  Decimal?       @db.Decimal(7, 4)
  status         ContractStatus @default(DRAFT)
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  createdById    String         @db.Uuid
  createdBy      User           @relation("Contract_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contract_created_by_id_fkey")
  updatedById    String?        @db.Uuid
  updatedBy      User?          @relation("Contract_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contract_updated_by_id_fkey")

  changeOrders     ChangeOrder[]
  progressBillings ProgressBilling[]

  @@unique([organizationId, id], map: "contract_org_id_key")
}

model ChangeOrder {
  id             String            @id(map: "change_order_pkey") @default(uuid(7)) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "change_order_organization_id_fkey")
  projectId      String            @db.Uuid
  project        Project           @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "change_order_project_id_org_fkey")
  contractId     String            @db.Uuid
  contract       Contract          @relation(fields: [organizationId, contractId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "change_order_contract_id_org_fkey")
  changeOrderNo  String
  type           ChangeOrderType
  description    String
  amount         Decimal           @db.Decimal(18, 2)
  /// Cache (§3.6): Σ ProgressBillingChangeOrder.amount of non-void billings; I-13 bounds it.
  billedAmount   Decimal           @default(0) @db.Decimal(18, 2)
  requestDate    DateTime          @db.Date
  approvalDate   DateTime?         @db.Date
  approvedById   String?           @db.Uuid
  approvedBy     User?             @relation("ChangeOrder_approvedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "change_order_approved_by_id_fkey")
  status         ChangeOrderStatus @default(DRAFT)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  createdById    String            @db.Uuid
  createdBy      User              @relation("ChangeOrder_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "change_order_created_by_id_fkey")
  updatedById    String?           @db.Uuid
  updatedBy      User?             @relation("ChangeOrder_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "change_order_updated_by_id_fkey")

  progressBillingChangeOrders ProgressBillingChangeOrder[]

  @@unique([organizationId, projectId, changeOrderNo], map: "change_order_organization_id_project_id_change_order_no_key")
  @@unique([organizationId, id], map: "change_order_org_id_key")
}

model ProjectBudget {
  id             String       @id(map: "project_budget_pkey") @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_budget_organization_id_fkey")
  projectId      String       @db.Uuid
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_budget_project_id_fkey")
  costCategoryId String       @db.Uuid
  costCategory   CostCategory @relation(fields: [costCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_budget_cost_category_id_fkey")
  budgetAmount   Decimal      @db.Decimal(18, 2)
  note           String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  createdById    String       @db.Uuid
  createdBy      User         @relation("ProjectBudget_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_budget_created_by_id_fkey")
  updatedById    String?      @db.Uuid
  updatedBy      User?        @relation("ProjectBudget_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_budget_updated_by_id_fkey")

  @@unique([projectId, costCategoryId], map: "project_budget_project_id_cost_category_id_key")
}

/// clientRequestId uniqueness per organization is a partial unique index (I-19).
model ProjectDailyLog {
  id              String       @id(map: "project_daily_log_pkey") @default(uuid(7)) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_daily_log_organization_id_fkey")
  projectId       String       @db.Uuid
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_daily_log_project_id_fkey")
  logDate         DateTime     @db.Date
  weather         String?
  workerCount     Int?
  content         String
  clientRequestId String?      @db.Uuid
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  createdById     String       @db.Uuid
  createdBy       User         @relation("ProjectDailyLog_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_daily_log_created_by_id_fkey")
  updatedById     String?      @db.Uuid
  updatedBy       User?        @relation("ProjectDailyLog_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "project_daily_log_updated_by_id_fkey")
}

// ---------------------------------------------------------------------------------------------
// Payables (§6.2). Financial core tables (§6.5) carry an (organizationId, id) target and use
// composite foreign keys to other core tables and to org-scoped master data.
// ---------------------------------------------------------------------------------------------

model Expense {
  id                    String         @id(map: "expense_pkey") @default(uuid(7)) @db.Uuid
  organizationId        String         @db.Uuid
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_organization_id_fkey")
  scope                 ExpenseScope
  projectId             String?        @db.Uuid
  project               Project?       @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "expense_project_id_org_fkey")
  /// Actual supplier; required from POSTED on (I-06).
  vendorId              String?        @db.Uuid
  vendor                Vendor?        @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "expense_vendor_id_org_fkey")
  /// Employee who advanced the payment (v0.3, ADR-26).
  advancedByEmployeeId  String?        @db.Uuid
  advancedByEmployee    Employee?      @relation(fields: [organizationId, advancedByEmployeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "expense_advanced_by_employee_id_org_fkey")
  /// Assigned when POSTED (TD-11).
  expenseNo             String?
  expenseDate           DateTime       @db.Date
  costCategoryId        String         @db.Uuid
  costCategory          CostCategory   @relation(fields: [organizationId, costCategoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "expense_cost_category_id_org_fkey")
  subtotalAmount        Decimal        @db.Decimal(18, 2)
  taxAmount             Decimal        @db.Decimal(18, 2)
  totalAmount           Decimal        @db.Decimal(18, 2)
  documentType          ExpenseDocType
  inputTaxDeductible    Boolean        @default(false)
  documentNumber        String?
  status                ExpenseStatus  @default(DRAFT)
  submittedAt           DateTime?      @db.Timestamptz(3)
  submittedById         String?        @db.Uuid
  submittedBy           User?          @relation("Expense_submittedBy", fields: [submittedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_submitted_by_id_fkey")
  reviewedAt            DateTime?      @db.Timestamptz(3)
  reviewedById          String?        @db.Uuid
  reviewedBy            User?          @relation("Expense_reviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_reviewed_by_id_fkey")
  reviewNote            String?
  rejectionReason       String?
  postedAt              DateTime?      @db.Timestamptz(3)
  postedById            String?        @db.Uuid
  postedBy              User?          @relation("Expense_postedBy", fields: [postedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_posted_by_id_fkey")
  /// Derived from the Payable (§6.3 rule 2); NULL before POSTED.
  paymentStatus         PaymentStatus?
  declaredPaymentStatus PaymentStatus?
  declaredPaidAmount    Decimal?       @db.Decimal(18, 2)
  declaredPaymentMethod PaymentMethod?
  dueDate               DateTime?      @db.Date
  note                  String?
  clientRequestId       String?        @db.Uuid
  voidedAt              DateTime?      @db.Timestamptz(3)
  voidedById            String?        @db.Uuid
  voidedBy              User?          @relation("Expense_voidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_voided_by_id_fkey")
  voidReason            String?
  version               Int            @default(1)
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(3)
  createdById           String         @db.Uuid
  createdBy             User           @relation("Expense_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_created_by_id_fkey")
  updatedById           String?        @db.Uuid
  updatedBy             User?          @relation("Expense_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_updated_by_id_fkey")

  expenseItems          ExpenseItem[]
  payables              Payable[]
  pettyCashTransactions PettyCashTransaction[]

  @@unique([organizationId, id], map: "expense_org_id_key")
}

/// No projectId on items (ADR-31). costAmount / costRuleVersion are snapshotted at POSTED
/// (§3.4, §14 R-11).
model ExpenseItem {
  id              String       @id(map: "expense_item_pkey") @default(uuid(7)) @db.Uuid
  organizationId  String       @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "expense_item_organization_id_fkey")
  expenseId       String       @db.Uuid
  expense         Expense      @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "expense_item_expense_id_org_fkey")
  costCategoryId  String       @db.Uuid
  costCategory    CostCategory @relation(fields: [organizationId, costCategoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "expense_item_cost_category_id_org_fkey")
  description     String?
  quantity        Decimal?     @db.Decimal(18, 4)
  unit            String?
  unitPrice       Decimal?     @db.Decimal(18, 2)
  amount          Decimal      @db.Decimal(18, 2)
  taxAmount       Decimal      @db.Decimal(18, 2)
  costAmount      Decimal?     @db.Decimal(18, 2)
  costRuleVersion Int?
  sortOrder       Int          @default(0)

  @@unique([organizationId, id], map: "expense_item_org_id_key")
}

model Payable {
  id                String        @id(map: "payable_pkey") @default(uuid(7)) @db.Uuid
  organizationId    String        @db.Uuid
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payable_organization_id_fkey")
  sourceType        PayableSource
  payeeType         PayeeType
  vendorId          String?       @db.Uuid
  vendor            Vendor?       @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payable_vendor_id_org_fkey")
  employeeId        String?       @db.Uuid
  employee          Employee?     @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payable_employee_id_org_fkey")
  /// 1 : 0..1 with Expense (§6.3 rule 1). Prisma models the relation as 1:N because the
  /// composite relation fields are not unique as a pair; payable_expense_id_key keeps it 0..1.
  expenseId         String?       @unique(map: "payable_expense_id_key") @db.Uuid
  expense           Expense?      @relation(fields: [organizationId, expenseId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payable_expense_id_org_fkey")
  scope             ExpenseScope
  projectId         String?       @db.Uuid
  project           Project?      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payable_project_id_org_fkey")
  payableNo         String
  originalAmount    Decimal       @db.Decimal(18, 2)
  /// Cache (ADR-09).
  paidAmount        Decimal       @default(0) @db.Decimal(18, 2)
  /// Cache (ADR-09).
  outstandingAmount Decimal       @db.Decimal(18, 2)
  dueDate           DateTime?     @db.Date
  status            PayableStatus @default(OPEN)
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  createdById       String        @db.Uuid
  createdBy         User          @relation("Payable_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payable_created_by_id_fkey")
  updatedById       String?       @db.Uuid
  updatedBy         User?         @relation("Payable_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payable_updated_by_id_fkey")

  payablePayments PayablePayment[]

  @@unique([organizationId, id], map: "payable_org_id_key")
}

model Payment {
  id                  String           @id(map: "payment_pkey") @default(uuid(7)) @db.Uuid
  organizationId      String           @db.Uuid
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_organization_id_fkey")
  payeeType           PayeeType
  vendorId            String?          @db.Uuid
  vendor              Vendor?          @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_vendor_id_org_fkey")
  employeeId          String?          @db.Uuid
  employee            Employee?        @relation(fields: [organizationId, employeeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_employee_id_org_fkey")
  /// Optional project tag for prepayments (§3.5).
  projectId           String?          @db.Uuid
  project             Project?         @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_project_id_org_fkey")
  bankAccountId       String           @db.Uuid
  bankAccount         BankAccount      @relation(fields: [organizationId, bankAccountId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payment_bank_account_id_org_fkey")
  paymentNo           String
  paymentDate         DateTime         @db.Date
  method              PaymentMethod
  paymentAmount       Decimal          @db.Decimal(18, 2)
  /// Cache (ADR-09): Σ active PayablePayment.amount.
  allocatedAmount     Decimal          @default(0) @db.Decimal(18, 2)
  /// Cache (ADR-09).
  unallocatedAmount   Decimal          @db.Decimal(18, 2)
  feeAmount           Decimal          @default(0) @db.Decimal(18, 2)
  feeBearer           FeeBearer        @default(COMPANY)
  /// Cache (ADR-09), defined by feeBearer (I-11).
  bankOutflowAmount   Decimal          @db.Decimal(18, 2)
  /// Cache (ADR-09), defined by feeBearer (I-11).
  payeeReceivedAmount Decimal          @db.Decimal(18, 2)
  clearingStatus      ClearingStatus   @default(NOT_APPLICABLE)
  clearedAt           DateTime?        @db.Timestamptz(3)
  clearedById         String?          @db.Uuid
  clearedBy           User?            @relation("Payment_clearedBy", fields: [clearedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_cleared_by_id_fkey")
  clearedDate         DateTime?        @db.Date
  bouncedAt           DateTime?        @db.Timestamptz(3)
  bouncedById         String?          @db.Uuid
  bouncedBy           User?            @relation("Payment_bouncedBy", fields: [bouncedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_bounced_by_id_fkey")
  bounceReason        String?
  checkNo             String?
  checkDueDate        DateTime?        @db.Date
  /// Reserved (TD-19).
  withholdingAmount   Decimal          @default(0) @db.Decimal(18, 2)
  note                String?
  clientRequestId     String?          @db.Uuid
  status              SettlementStatus @default(POSTED)
  voidedAt            DateTime?        @db.Timestamptz(3)
  voidedById          String?          @db.Uuid
  voidedBy            User?            @relation("Payment_voidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_voided_by_id_fkey")
  voidReason          String?
  version             Int              @default(1)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)
  createdById         String           @db.Uuid
  createdBy           User             @relation("Payment_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_created_by_id_fkey")
  updatedById         String?          @db.Uuid
  updatedBy           User?            @relation("Payment_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payment_updated_by_id_fkey")

  payablePayments PayablePayment[]

  @@unique([organizationId, id], map: "payment_org_id_key")
}

/// Active allocation ⇔ voidedAt IS NULL (ADR-25); one active row per pair (I-01).
model PayablePayment {
  id             String       @id(map: "payable_payment_pkey") @default(uuid(7)) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payable_payment_organization_id_fkey")
  paymentId      String       @db.Uuid
  payment        Payment      @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payable_payment_payment_id_org_fkey")
  payableId      String       @db.Uuid
  payable        Payable      @relation(fields: [organizationId, payableId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "payable_payment_payable_id_org_fkey")
  amount         Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  createdById    String       @db.Uuid
  createdBy      User         @relation("PayablePayment_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payable_payment_created_by_id_fkey")
  voidedAt       DateTime?    @db.Timestamptz(3)
  voidedById     String?      @db.Uuid
  voidedBy       User?        @relation("PayablePayment_voidedBy", fields: [voidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "payable_payment_voided_by_id_fkey")
  voidReason     String?

  @@unique([organizationId, id], map: "payable_payment_org_id_key")
}

model PettyCashTransaction {
