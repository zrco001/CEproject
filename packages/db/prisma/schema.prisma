  createdById       String          @db.Uuid
  createdBy         User            @relation("ProgressBillingChangeOrder_createdBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "progress_billing_change_order_created_by_id_fkey")

  @@unique([progressBillingId, changeOrderId], map: "progress_billing_change_order_pair_key")
  @@unique([organizationId, id], map: "progress_billing_change_order_org_id_key")
}

