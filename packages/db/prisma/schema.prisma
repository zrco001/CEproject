// CEproject Phase 2 schema — ARCHITECTURE.md (Architecture Approved v0.3) §5, §6.1–§6.5.
//
// Strategy accepted by Gate 0 / ADR-034 (run 37741573406, native-candidate):
// - (organizationId, id) unique targets and composite foreign keys (§6.5, I-21) are declared
//   natively here, so Prisma keeps them in future migration drafts;
// - CHECK constraints, partial unique indexes and the AuditLog REVOKE (I-20) cannot be expressed
//   in Prisma and are appended to the init migration; they are listed in
//   prisma/constraints.registry.ts and documented in prisma/constraints.md.
//
// Conventions (§5.1, §2.6, §2.7, §6.5):
// - Tables keep their Prisma model names; every constraint and index name is snake_case.
// - UUID ids (v7 generated by the client), TIMESTAMPTZ instants, DATE business dates,
//   money Decimal(18,2), rates Decimal(7,4), progress percentages Decimal(5,2).
// - Every foreign key is ON DELETE RESTRICT ON UPDATE RESTRICT (§6.5 rule 5).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

