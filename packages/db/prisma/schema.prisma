  updatedById           String?               @db.Uuid
  updatedBy             User?                 @relation("ProgressBilling_updatedBy", fields: [updatedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "progress_billing_updated_by_id_fkey")

