# Copy to .env for local development and replace every <placeholder>.
# Never commit .env or any real credentials.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# LOG_LEVEL=debug
APP_VERSION=0.0.0

# --- Web (apps/web) ---
# Where Next.js rewrites /api/* to (build-time for `next build`, runtime for `next dev`).
API_INTERNAL_URL=http://localhost:4000

# --- PostgreSQL (docker compose; used from Phase 2) ---
POSTGRES_USER=ceproject
POSTGRES_PASSWORD=<change-me-local-db-password>
POSTGRES_DB=ceproject
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ceproject:<change-me-local-db-password>@localhost:5432/ceproject?schema=public

# --- S3-compatible storage / MinIO (used from Phase 4) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<change-me-minio-user>
# MinIO requires at least 8 characters.
S3_SECRET_ACCESS_KEY=<change-me-minio-password>
S3_BUCKET=ceproject-attachments
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Mailpit (dev SMTP, used from Phase 3) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
